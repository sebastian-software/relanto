{
  "name": "relanto",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>",
  "main": "index.js",
  "scripts": {
    "dev": "dotenv -e packages/frontend/.env.development -- pnpm --filter @relanto/frontend dev",
    "i18n:extract": "pnpm --filter @relanto/frontend i18n:extract",
    "lint": "pnpm -r --if-present lint",
    "lint:eslint": "pnpm -r --if-present lint:eslint",
    "lint:oxlint": "pnpm -r --if-present lint:oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "agent:check:ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-config-setup": "^0.4.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.73.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
