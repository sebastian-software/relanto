# Automatically loaded by `pnpm dev`.
# Admin UI access requires a Pocket ID user in the `superadmin` group.

POCKET_ID_ISSUER=https://pocket-id.example.com
POCKET_ID_CLIENT_ID=mailer-dev
POCKET_ID_CLIENT_SECRET=
POCKET_ID_REDIRECT_URI=http://localhost:5173/auth/callback
POCKET_ID_GROUPS_CLAIM=groups
POCKET_ID_REQUIRED_GROUP=superadmin

# Keep the SQLite database in the repository tmp directory during local development.
MAILER_DB_PATH=../../tmp/mailer.sqlite
# Generate on macOS, for example:
# openssl rand -hex 32
APP_SESSION_SECRET=__REPLACE_WITH_OPENSSL_RAND_HEX_32__
# Generate on macOS, for example:
# openssl rand -hex 32
MAILER_SECRET_KEY=__REPLACE_WITH_OPENSSL_RAND_HEX_32__
MAILER_WORKER_INTERVAL_MS=2500
