{
  "name": "@relanto/frontend",
  "version": "0.19.8",
  "private": true,
  "license": "MIT",
  "files": [
    "build",
    "serverStartup.mjs"
  ],
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "i18n:extract": "node ./node_modules/@palamedes/cli/dist/cli.mjs extract --config ./palamedes.config.ts",
    "start": "NODE_OPTIONS=--import=./serverStartup.mjs react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:oxlint": "oxlint app",
    "lint:eslint": "react-router typegen && eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@palamedes/core": "^1.0.0",
    "@palamedes/core-node": "^1.0.0",
    "@palamedes/react": "^1.0.0",
    "@palamedes/runtime": "^1.0.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@relanto/backend": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "isbot": "^5.1.44",
    "openid-client": "^6.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@palamedes/cli": "^1.0.0",
    "@palamedes/config": "^1.0.0",
    "@palamedes/transform": "^1.0.0",
    "@palamedes/vite-plugin": "^1.0.0",
    "@react-router/dev": "8.3.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-setup": "^0.4.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.73.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
