{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "packages": {
    "packages/backend": {
      "component": "backend",
      "package-name": "@relanto/backend",
      "release-type": "node"
    },
    "packages/frontend": {
      "component": "frontend",
      "package-name": "@relanto/frontend",
      "release-type": "node"
    }
  },
  "plugins": [
    {
      "merge": false,
      "type": "node-workspace"
    },
    {
      "components": ["backend", "frontend"],
      "groupName": "relanto",
      "type": "linked-versions"
    }
  ]
}
